{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "standard": {
            "format": "%(levelname)s - %(asctime)s - %(name)s - %(message)s"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "standard",
            "level": "DEBUG"
        },
        "file_handler": {
            "class": "logging.FileHandler",
            "formatter": "standard",
            "level": "DEBUG",
            "filename": "app.log"
        }
    },
    "loggers": {
        "db_connector": {
            "handlers": [
                "console",
                "file_handler"
            ],
            "level": "DEBUG",
            "propagate": false
        },
        "openai_connector": {
            "handlers": [
                "console",
                "file_handler"
            ],
            "level": "DEBUG",
            "propagate": false
        },
        "remote_methods": {
            "handlers": [
                "console",
                "file_handler"
            ],
            "level": "DEBUG",
            "propagate": false
        },
        "__main__": {
            "handlers": [
                "console",
                "file_handler"
            ],
            "level": "DEBUG",
            "propagate": false
        },
        "ingest_console": {
            "handlers": [
                "console",
                "file_handler"
            ],
            "level": "DEBUG",
            "propagate": false
        }
    }
}